@using webcvone.Models.entitty
@model List<tbl_egitim>

@{
    ViewBag.Title = "Eğitim Listesi";
    Layout = "~/Views/Shared/admin_panel.cshtml";
}

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold text-primary">Eğitim Bilgilerim</h6>
        <a href="/Admin/EgitimEkle" class="btn btn-success btn-sm">
            <i class="fas fa-plus"></i> Yeni Eğitim Ekle
        </a>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover" id="dataTable" width="100%" cellspacing="0">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Okul Adı</th>
                        <th>Bölüm</th>
                        <th>GPA</th>
                        <th>Eğitim Detayı</th>
                        <th>Mezuniyet Yılı</th>
                        <th style="width: 120px;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var egitim in Model)
                    {
                        <tr>
                            <td>@egitim.ID</td>
                            <td>@egitim.OkulAd</td>
                            <td>@egitim.Bolum</td>
                            <td>@egitim.GPA</td>
                            <td>@egitim.EgitimDetay</td>
                            <td>@egitim.MezuniyetYili</td>
                            <td>
                                <a href="/Admin/EgitimGetir/@egitim.ID" class="btn btn-warning btn-sm" title="Düzenle">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a href="/Admin/EgitimSil/@egitim.ID" class="btn btn-danger btn-sm" title="Sil" onclick="return confirm('Bu eğitimi silmek istediğinize emin misiniz?')">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>