@using webcvone.Models.entitty
@model List<work_flow>
@{
    ViewBag.Title = "Proje Listesi";
    Layout = "~/Views/Shared/admin_panel.cshtml";
}

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-tasks me-2"></i>Teknik Projelerim (Work Flow)</h6>
        <a href="/Admin/ProjeEkle" class="btn btn-success btn-sm">
            <i class="fas fa-plus"></i> Yeni Proje Ekle
        </a>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover" id="dataTable" width="100%" cellspacing="0">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Proje Adı</th>
                        <th>Kategori</th>
                        <th>Teknoloji</th>
                        <th>Durum</th>
                        <th style="width: 150px;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td><strong>@item.ProjeAd</strong></td>
                            <td><span class="badge bg-info text-dark">@item.Category</span></td>
                            <td>@item.Technology</td>
                            <td>
                                @* Tırnak işaretlerini kaldırarak doğrudan sayı ile kıyaslıyoruz *@
                                @if (item.Hazır == 1)
                                {
                                    <span class="badge bg-success">
                                        <i class="fas fa-check-circle me-1"></i> Tamamlandı
                                    </span>
                                }
                                else if (item.Hazır == 2)
                                {
                                    <span class="badge bg-warning text-dark">
                                        <i class="fas fa-spinner fa-spin me-1"></i> Devam Ediyor
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@item.Hazır</span>
                                }
                            </td>
                            <td>
                                <a href="/Admin/ProjeGetir?id=@item.Id" class="btn btn-warning btn-sm" title="Düzenle">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a href="/Admin/ProjeSil/@item.Id" class="btn btn-danger btn-sm" title="Sil" onclick="return confirm('Bu projeyi silmek istediğinize emin misiniz?')">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>