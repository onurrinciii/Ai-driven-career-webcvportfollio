@using webcvone.Models.entitty
@model List<detay_profil>
@{
    ViewBag.Title = "Kariyer Deneyimlerim";
    Layout = "~/Views/Shared/admin_panel.cshtml";
}

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold text-primary">İş Deneyimleri</h6>
        <a href="/Admin/KariyerEkle" class="btn btn-success btn-sm">Yeni Deneyim Ekle</a>
    </div>
    <div class="card-body">
        <table class="table table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Şirket</th>
                    <th>Pozisyon</th>
                    <th>Tarih</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var x in Model)
                {
                    <tr>
                        <td>@x.Sırket</td>
                        <td>@x.Pozisyon</td>
                        <td>@x.tarih</td>
                        <td>
                            <a href="/Admin/KariyerGetir/@x.ıd" class="btn btn-warning btn-sm">Düzenle</a>
                            <a href="/Admin/KariyerSil/@x.ıd" class="btn btn-danger btn-sm" onclick="return confirm('Silinsin mi?')">Sil</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>