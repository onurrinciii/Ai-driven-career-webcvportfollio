@using webcvone.Models.entitty
@model List<tbl_sertifika>
@{
    ViewBag.Title = "Sertifikalarım";
    Layout = "~/Views/Shared/admin_panel.cshtml";
}

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold text-primary">Sertifika Listesi</h6>
        <a href="/Admin/SertifikaEkle" class="btn btn-success btn-sm">
            <i class="fas fa-plus"></i> Yeni Sertifika Ekle
        </a>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Sertifika Adı</th>
                        <th>Kurum</th>
                        <th>Tarih</th>
                        <th>İkon</th>
                        <th style="width: 150px;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var x in Model)
                    {
                        <tr>
                            <td>@x.ID</td>
                            <td>@x.SertifikaAd</td>
                            <td>@x.Kurum</td>
                            <td>@x.Tarih</td>
                            <td><i class="@x.Ikon"></i> (@x.Ikon)</td>
                            <td>
                                <a href="/Admin/SertifikaGetir?id=@x.ID" class="btn btn-warning btn-sm">Düzenle</a>
                                <a href="/Admin/SertifikaSil/@x.ID" class="btn btn-danger btn-sm" onclick="return confirm('Silinsin mi?')">Sil</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>