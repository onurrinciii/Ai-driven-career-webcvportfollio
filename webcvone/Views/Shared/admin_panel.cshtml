
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Paneli - Onur İNCİ</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <script src="https://use.fontawesome.com/releases/v6.3.0/js/all.js"></script>
</head>
<body>
    <div class="d-flex" id="wrapper">
        <div class="bg-dark text-white p-3" style="min-width: 250px; min-height: 100vh;">
            <h4 class="text-center">Onur CV Admin</h4>
            <hr>
            <ul class="nav flex-column">
                <li class="nav-item"><a href="/Admin/AdminP" class="nav-link text-white"><i class="fas fa-home me-2"></i>Dashboard</a></li>
                <li class="nav-item"><a href="/Admin/EgitimListesi" class="nav-link text-white"><i class="fas fa-graduation-cap me-2"></i>Eğitimlerim</a></li>
                <li class="nav-item"><a href="/Admin/SertifikaListesi" class="nav-link text-white"><i class="fas fa-graduation-cap me-2"></i>Sertifikalarım</a></li>
               <li class="nav-item"><a href="/Admin/KariyerListesi" class="nav-link text-white"><i class="fas fa-briefcase me-2"></i>Kariyer</a></li>
                <li class="nav-item"><a href="/Admin/Mesajlar" class="nav-link text-white"><i class="fas fa-envelope me-2"></i>Gelen Mesajlar</a></li>
            </ul>
        </div>

        <div class="container-fluid p-4">
            @RenderBody()
        </div>
    </div>
</body>
</html>