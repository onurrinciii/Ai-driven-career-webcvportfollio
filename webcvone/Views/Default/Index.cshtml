@using webcvone.Models.entitty
@model List<aciklamalar>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content="Onur İnci - Backend Developer Portfolyosu | C#, .NET Core, SQL ve Flutter Geliştirici" />
    <title>Onur İNCİ | Backend Developer</title>
    <link rel="icon" type="image/x-icon" href="/boostrapstart/assets/favicon.ico" />
    
    <script src="https://use.fontawesome.com/releases/v6.3.0/js/all.js" crossorigin="anonymous"></script>
    <link href="https://fonts.googleapis.com/css?family=Montserrat:400,700" rel="stylesheet" type="text/css" />
    <link href="https://fonts.googleapis.com/css?family=Lato:400,700,400italic,700italic" rel="stylesheet" type="text/css" />
    <link href="/boostrapstart/css/styles.css" rel="stylesheet" />

    <style>
        :root {
            /* Modern Tech Paleti */
            --primary-color: #2563eb;
            --primary-dark: #1d4ed8;
            --secondary-color: #0f172a;
            --accent-color: #38bdf8;
            --bg-light: #f8fafc;
            --text-main: #1e293b;
        }

        body {
            font-family: 'Lato', sans-serif;
            background-color: var(--bg-light);
            color: var(--text-main);
            scroll-behavior: smooth;
        }

        /* 1. TÜM ARKA PLAN RENKLERİNİ EZ (Baskın Renk) */
        .bg-primary {
            background-color: var(--primary-color) !important;
        }

        .bg-secondary {
            background-color: var(--secondary-color) !important;
        }

        /* 2. BUTON MODERNİZASYONU (Gönder ve Diğerleri) */
        .btn-primary, #submitButton {
            background-color: var(--primary-color) !important;
            border-color: var(--primary-color) !important;
            font-weight: 700 !important;
            padding: 1rem 2rem !important;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .btn-primary:hover, #submitButton:hover {
            background-color: var(--primary-dark) !important;
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(37, 99, 235, 0.2) !important;
        }

        /* Hakkımda Bölümündeki Çerçeveli Buton */
        .btn-outline-light {
            border-width: 2px !important;
            font-weight: 600 !important;
            transition: all 0.3s ease !important;
        }

        .btn-outline-light:hover {
            background-color: white !important;
            color: var(--primary-color) !important;
            transform: scale(1.05);
        }

        /* 3. KART VE PORTFOLYO TASARIMI */
        .education-card, .career-card, .project-card, .certificate-card {
            transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
            border: none !important;
            border-top: 4px solid var(--primary-color) !important;
            border-radius: 16px !important;
            background: #ffffff;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            height: 100%; /* Yükseklik eşitleme */
        }

        .education-card:hover, .career-card:hover, .project-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 30px rgba(15, 23, 42, 0.1) !important;
        }

        /* 4. MASTHEAD (Giriş Alanı) */
        .masthead {
            padding-top: calc(8rem + 74px);
            padding-bottom: 7rem;
            background: radial-gradient(circle at top right, var(--primary-color), var(--secondary-color)) !important;
        }

        .masthead-avatar {
            width: 180px;
            border: 6px solid rgba(255, 255, 255, 0.2);
            transition: transform 0.5s ease;
        }

        .masthead-avatar:hover {
            transform: rotate(5deg) scale(1.05);
        }

        /* 5. FORM ALANLARI */
        .form-control {
            border-radius: 12px !important;
            padding: 1rem !important;
            border: 2px solid transparent !important;
            background-color: #f1f5f9 !important;
        }

        .form-control:focus {
            background-color: #fff !important;
            border-color: var(--primary-color) !important;
            box-shadow: 0 0 0 0.25rem rgba(37, 99, 235, 0.1) !important;
        }

        /* 6. CAROUSEL STABILIZASYONU (Yükseklik Farkları İçin) */
        .carousel-item {
            min-height: 450px; /* İçeriğe göre ayarlanabilir */
            padding: 20px;
        }

        .carousel-inner {
            display: flex;
            align-items: center;
        }

        .carousel-item.active,
        .carousel-item-next,
        .carousel-item-prev {
            display: block;
        }

        /* 7. RAZOR ESCAPE & MEDIA QUERIES */
        @@media (max-width: 991.98px) {
            .masthead {
                padding-top: calc(6rem + 74px);
                padding-bottom: 4rem;
            }
            .border-start-lg {
                border-left: none !important;
                border-top: 1px solid rgba(255,255,255,0.2);
                margin-top: 2rem;
                padding-top: 2rem;
            }
        }

        .year-badge {
            background: white;
            color: var(--secondary-color);
            padding: 6px 14px;
            border-radius: 12px;
            font-size: 0.85rem;
            font-weight: 600;
            border: 2px solid var(--primary-color);
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            white-space: nowrap;
        }

        .tech-badge {
            background: rgba(37, 99, 235, 0.1);
            color: var(--primary-color);
            font-weight: 700;
            padding: 4px 10px;
            border-radius: 6px;
            font-size: 0.75rem;
        }
    </style>
</head>
<body id="page-top">
    <nav class="navbar navbar-expand-lg bg-secondary text-uppercase fixed-top shadow-sm" id="mainNav">
        <div class="container">
            <a class="navbar-brand fw-bold text-white-50 ms-2 small" href="/Login/LoginHome" title="Yönetim Paneli">Onur İNCİ</a>
            <button class="navbar-toggler text-uppercase font-weight-bold bg-primary text-white rounded" type="button" data-bs-toggle="collapse" data-bs-target="#navbarResponsive">
                <i class="fas fa-bars"></i>
            </button>
            <div class="collapse navbar-collapse" id="navbarResponsive">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item mx-0 mx-lg-1"><a class="nav-link py-3 px-0 px-lg-3 rounded" href="#portfolio">Deneyim & Projeler</a></li>
                    <li class="nav-item mx-0 mx-lg-1"><a class="nav-link py-3 px-0 px-lg-3 rounded" href="#about">Hakkımda</a></li>
                    <li class="nav-item mx-0 mx-lg-1"><a class="nav-link py-3 px-0 px-lg-3 rounded" href="#contact">İletişim</a></li>
                </ul>
            </div>
        </div>
    </nav>

    @if (Model != null && Model.Any())
    {
        var webcv = Model.First();
        <header class="masthead text-white text-center">
            <div class="container d-flex align-items-center flex-column">
                <img class="masthead-avatar mb-5 rounded-circle border border-4 border-white shadow-lg" src="/boostrapstart/assets/img/avataaars.svg" alt="Onur İnci Profil Fotoğrafı" />
                <h1 class="masthead-heading text-uppercase mb-0">@webcv.ad @webcv.soyad</h1>
                <div class="divider-custom divider-light">
                    <div class="divider-custom-line"></div>
                    <div class="divider-custom-icon"><i class="fas fa-terminal"></i></div>
                    <div class="divider-custom-line"></div>
                </div>
                <p class="masthead-subheading mb-0 fw-light">Backend Developer | C# & .NET | SQL | Flutter</p>
            </div>
        </header>

        <section class="page-section portfolio" id="portfolio">
            <div class="container">
                <h2 class="page-section-heading text-center text-uppercase text-secondary mb-0">Kariyer Yolculuğu</h2>
                <div class="divider-custom">
                    <div class="divider-custom-line"></div>
                    <div class="divider-custom-icon"><i class="fas fa-laptop-code"></i></div>
                    <div class="divider-custom-line"></div>
                </div>
                <div class="row justify-content-center">
                    <div class="col-md-6 col-lg-5 mb-5 text-center">
                        <div class="portfolio-item mx-auto" data-bs-toggle="modal" data-bs-target="#deneyimModal" style="cursor:pointer" aria-label="CV Detaylarını Aç">
                            <div class="portfolio-item-caption d-flex align-items-center justify-content-center h-100 w-100 position-absolute">
                                <div class="portfolio-item-caption-content text-center text-white">
                                    <i class="fas fa-search-plus fa-3x"></i><br>
                                    <span class="fw-bold mt-2 d-block text-uppercase">Detayları Gör</span>
                                </div>
                            </div>
                            <img class="img-fluid w-100" src="/boostrapstart/assets/img/portfolio/cabin.png" alt="Eğitim ve İş Deneyimi Görseli" />
                        </div>
                        <h4 class="mt-4 text-secondary fw-bold">Eğitim & İş Deneyimi</h4>
                        <p class="text-muted px-3">Teknik altyapım, akademik geçmişim ve sertifikalarımın detaylı dökümü.</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="page-section bg-primary text-white mb-0" id="about">
            <div class="container">
                <h2 class="page-section-heading text-center text-uppercase text-white">Hakkımda</h2>
                <div class="divider-custom divider-light">
                    <div class="divider-custom-line"></div>
                    <div class="divider-custom-icon"><i class="fas fa-user-tie"></i></div>
                    <div class="divider-custom-line"></div>
                </div>
                <div class="row justify-content-center">
                    <div class="col-lg-5 ms-auto text-lg-end text-center">
                        <p class="lead">@webcv.aciklama_info</p>
                    </div>
                    <div class="col-lg-5 me-auto text-lg-start text-center border-start-lg border-white-50">
                        <p class="lead">@webcv.aciklama_info1</p>
                    </div>
                </div>
                <div class="text-center mt-5">
                    <a class="btn btn-xl btn-outline-light shadow-lg rounded-pill px-5 fw-bold" href="/boostrapstart/assets/Onur_Inci_CV.pdf" download>
                        <i class="fas fa-file-pdf me-2"></i> ÖZGEÇMİŞİ İNDİR
                    </a>
                </div>
            </div>
        </section>
    }

    <div class="portfolio-modal modal fade" id="deneyimModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header border-0 justify-content-end">
                    <button class="btn-close shadow-none p-3" type="button" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body pb-5 pt-0">
                    <div class="container">
                        <div id="deneyimSlider" class="carousel carousel-dark slide" data-bs-ride="false">
                            <div class="carousel-inner">
                                <div class="carousel-item active">
                                    <h3 class="text-secondary text-center text-uppercase fw-bold mb-5">
                                        <i class="fas fa-graduation-cap me-2 text-primary"></i> Akademik Geçmiş
                                    </h3>
                                    <div class="mx-auto" style="max-width: 800px;">
                                        @if (ViewBag.EgitimVerileri != null)
                                        {
                                            foreach (var egitim in ViewBag.EgitimVerileri)
                                            {
                                                <div class="mb-4 p-4 education-card">
                                                    <div class="d-flex justify-content-between align-items-center">
                                                        <h5 class="text-primary fw-bold mb-0">@egitim.OkulAd</h5>
                                                        <span class="year-badge">@egitim.MezuniyetYili</span>
                                                    </div>
                                                    <p class="mt-2 text-dark mb-0">@egitim.Bolum</p>
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                                <div class="carousel-item">
                                    <h3 class="text-secondary text-center text-uppercase fw-bold mb-4">
                                        <i class="fas fa-award me-2 text-primary"></i> Sertifikalar
                                    </h3>
                                    <div class="mx-auto" style="max-width: 800px;">
                                        @if (ViewBag.SertifikaVerileri != null)
                                        {
                                            foreach (var sertifika in ViewBag.SertifikaVerileri)
                                            {
                                                <div class="mb-3 p-3 certificate-card d-flex align-items-center justify-content-between shadow-sm border">
                                                    <div class="d-flex align-items-center">
                                                        <div class="icon-circle me-3">
                                                            <i class="@(string.IsNullOrEmpty(sertifika.Ikon) ? "fas fa-medal" : sertifika.Ikon)"></i>
                                                        </div>
                                                        <div>
                                                            <h6 class="fw-bold mb-0 text-dark">@sertifika.SertifikaAd</h6>
                                                            <small class="text-muted">@sertifika.Kurum | @(sertifika.Tarih is DateTime dt ? dt.ToString("MMMM yyyy") : "")</small>
                                                        </div>
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(sertifika.SertifikaLink))
                                                    {
                                                        <a href="@sertifika.SertifikaLink" target="_blank" class="btn btn-sm btn-primary rounded-pill px-3">İncele</a>
                                                    }
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                                <div class="carousel-item">
                                    <h3 class="text-secondary text-center text-uppercase fw-bold mb-5">
                                        <i class="fas fa-history me-2 text-primary"></i> Profesyonel Deneyim
                                    </h3>
                                    <div class="mx-auto" style="max-width: 800px;">
                                        @if (ViewBag.KariyerVerileri != null)
                                        {
                                            foreach (var kariyer in ViewBag.KariyerVerileri)
                                            {
                                                <div class="mb-4 p-4 career-card">
                                                    <div class="d-flex justify-content-between align-items-start">
                                                        <div>
                                                            <h5 class="text-primary fw-bold mb-1">@kariyer.Sırket</h5>
                                                            <h6 class="fw-bold text-secondary">@kariyer.Pozisyon</h6>
                                                        </div>
                                                        <span class="badge bg-light text-dark border px-3 py-2">
                                                            @(kariyer.tarih != null ? kariyer.tarih.ToString("MMM yyyy") : "")
                                                        </span>
                                                    </div>
                                                    <div class="mt-3 text-muted border-top pt-3 small">
                                                        <i class="fas fa-chevron-right me-2 text-primary small"></i> @kariyer.deneyim_notu
                                                    </div>
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>

                                <div class="carousel-item">
                                    <h3 class="text-secondary text-center text-uppercase fw-bold mb-5">
                                        <i class="fas fa-project-diagram me-2 text-primary"></i> Teknik Projeler
                                    </h3>
                                    <div class="mx-auto" style="max-width: 900px;">
                                        @if (ViewBag.WorkFlowVerileri != null)
                                        {
                                            <div class="row g-4">
                                                @foreach (var proje in ViewBag.WorkFlowVerileri)
                                                {
                                                    <div class="col-md-6">
                                                        <div class="p-4 project-card h-100">
                                                            <div class="d-flex justify-content-between align-items-center mb-3">
                                                                <h6 class="fw-bold text-dark mb-0">@proje.ProjeAd</h6>
                                                                <i class="fas fa-circle @(proje.Hazır == 1 ? "text-success" : "text-warning")" 
                                                                   style="font-size:10px" 
                                                                   title="@(proje.Hazır == 1 ? "Tamamlandı" : "Geliştiriliyor")"></i>
                                                            </div>
                                                            <div class="d-flex flex-wrap gap-2">
                                                                @if (!string.IsNullOrEmpty(proje.Technology))
                                                                {
                                                                    foreach (var tech in proje.Technology.Split(','))
                                                                    {
                                                                        <span class="tech-badge">@tech.Trim()</span>
                                                                    }
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                            <button class="carousel-control-prev" type="button" data-bs-target="#deneyimSlider" data-bs-slide="prev">
                                <span class="carousel-control-prev-icon bg-dark rounded-circle" aria-hidden="true"></span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#deneyimSlider" data-bs-slide="next">
                                <span class="carousel-control-next-icon bg-dark rounded-circle" aria-hidden="true"></span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <section class="page-section bg-light" id="contact">
        <div class="container">
            <h2 class="page-section-heading text-center text-uppercase text-secondary mb-0">İletişime Geç</h2>
            <div class="divider-custom">
                <div class="divider-custom-line"></div>
                <div class="divider-custom-icon"><i class="fas fa-paper-plane"></i></div>
                <div class="divider-custom-line"></div>
            </div>
            <div class="row justify-content-center">
                <div class="col-lg-7">
                    @using (Html.BeginForm("Index", "Default", FormMethod.Post, new { @id = "contactForm", @class = "p-4 p-md-5 bg-white rounded-4 shadow-lg" }))
                    {
                        <div class="form-floating mb-3">
                            <input class="form-control border-0 bg-light" name="Ad_syd" id="name" type="text" placeholder="Ad Soyad" required />
                            <label for="name">Ad Soyad</label>
                        </div>
                        <div class="form-floating mb-3">
                            <input class="form-control border-0 bg-light" name="Mail" id="email" type="email" placeholder="name@example.com" required />
                            <label for="email">E-posta Adresi</label>
                        </div>
                        <div class="form-floating mb-3">
                            <input class="form-control border-0 bg-light" name="Konu" id="subject" type="text" placeholder="Konu" required />
                            <label for="subject">Konu</label>
                        </div>
                        <div class="form-floating mb-4">
                            <textarea class="form-control border-0 bg-light" name="Mesaj" id="message" placeholder="Mesajınız" style="height: 10rem" required></textarea>
                            <label for="message">Mesajınız</label>
                        </div>
                        <button class="btn btn-primary btn-xl w-100 rounded-pill fw-bold" id="submitButton" type="submit">GÖNDER</button>
                    }
                </div>
            </div>
        </div>
    </section>

    <footer class="footer text-center bg-secondary text-white py-5">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4">
                    <h5 class="text-uppercase mb-4 fw-bold">Lokasyon</h5>
                    <p class="lead mb-0"><i class="fas fa-map-marker-alt text-primary me-2"></i> Görükle / Bursa</p>
                </div>
                <div class="col-lg-4">
                    <h5 class="text-uppercase mb-4 fw-bold">Network</h5>
                    <a class="btn btn-outline-light btn-social mx-1" href="https://www.linkedin.com/in/onurrri%CC%87nci/" target="_blank"><i class="fab fa-fw fa-linkedin-in"></i></a>
                    <a class="btn btn-outline-light btn-social mx-1" href="https://github.com/onurrinciii" target="_blank"><i class="fab fa-fw fa-github"></i></a>
                </div>
                <div class="col-lg-4">
                    <h5 class="text-uppercase mb-4 fw-bold">Yetenekler</h5>
                    <p class="small opacity-75">ASP.NET MVC, .NET Core, SQL Server & Flutter</p>
                </div>
            </div>
        </div>
        <div id="aiChatContainer" style="position:fixed; bottom:20px; right:20px; z-index:9999;">
            <button id="openChat" style="background:#2563eb;color:white;border:none;border-radius:50px;padding:12px 20px;font-weight:bold;box-shadow:0 5px 20px rgba(0,0,0,0.2)">
                🤖 AI Asistan
            </button>
            <div id="chatBox" style="display:none;width:320px;height:420px;background:white;border-radius:12px;box-shadow:0 10px 30px rgba(0,0,0,0.2);margin-top:10px;overflow:hidden">
                <div style="background:#2563eb;color:white;padding:10px;font-weight:bold">Onur AI Asistan</div>
                <div id="chatMessages" style="height:310px;overflow-y:auto;padding:10px;font-size:14px"></div>
                <div style="display:flex;border-top:1px solid #eee">
                    <input id="userMessage" type="text" placeholder="Bir şey sor..." style="flex:1;border:none;padding:10px;outline:none">
                    <button id="sendMessage" style="background:#2563eb;color:white;border:none;padding:10px 15px">Gönder</button>
                </div>
            </div>
        </div>
    </footer>

    <div class="copyright py-4 text-center text-white bg-dark">
        <div class="container"><small>© @DateTime.Now.Year - Onur İNCİ | Backend Developer Portfolio</small></div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
    $(function () {
        $('a.nav-link[href^="#"]').on('click', function (e) {
            const target = document.querySelector(this.getAttribute('href'));
            if (target) {
                e.preventDefault();
                window.scrollTo({
                    top: target.offsetTop - 70,
                    behavior: "smooth"
                });
                $('.navbar-collapse').collapse('hide');
            }
        });

        $('#contactForm').on('submit', function (e) {
            e.preventDefault();
            const btn = $('#submitButton');
            const form = $(this);
            btn.prop('disabled', true);
            btn.html('<i class="fas fa-spinner fa-spin me-2"></i> Gönderiliyor...');

            $.ajax({
                url: form.attr('action'),
                type: 'POST',
                data: form.serialize(),
                success: function () {
                    Swal.fire({ title: 'Başarılı!', text: 'Mesajınız iletildi.', icon: 'success', confirmButtonColor: '#2563eb' });
                    form[0].reset();
                },
                error: function () {
                    Swal.fire({ title: 'Hata!', text: 'Sorun oluştu.', icon: 'error' });
                },
                complete: function () {
                    btn.prop('disabled', false);
                    btn.html('GÖNDER');
                }
            });
        });

        const chatBox = $("#chatBox");
        const chatMessages = $("#chatMessages");
        const userInput = $("#userMessage");

        $("#openChat").on("click", function () { chatBox.fadeToggle(120); });

        function addMessage(text, sender) {
            const align = sender === "user" ? "right" : "left";
            const bg = sender === "user" ? "#2563eb" : "#f1f5f9";
            const color = sender === "user" ? "white" : "black";
            const messageHtml = `<div style="text-align:${align}; margin-bottom:8px;"><span style="display:inline-block;background:${bg};color:${color};padding:8px 12px;border-radius:10px;max-width:80%;">${text}</span></div>`;
            chatMessages.append(messageHtml);
            chatMessages.scrollTop(chatMessages[0].scrollHeight);
        }

        $("#sendMessage").on("click", function () {
            const message = userInput.val().trim();
            if (!message) return;
            addMessage(message, "user");
            userInput.val("");
            $.post("/aibotchat/AskAI", { message: message }, function (res) {
                if (res && res.reply) addMessage(res.reply, "ai");
                else addMessage("AI cevap veremedi.", "ai");
            }).fail(function() { addMessage("Servis hatası.", "ai"); });
        });

        userInput.on("keydown", function (e) { if (e.key === "Enter") { e.preventDefault(); $("#sendMessage").click(); } });
    });
    </script>
</body>
</html>